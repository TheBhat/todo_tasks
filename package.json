{
  "name": "todo-plus-plus",
  "displayName": "Todo++",
  "description": "Interactive todo list editor for markdown task files with inline editing, nested indentation, and one-click progress toggles.",
  "version": "1.0.0",
  "publisher": "aditya-bhat",
  "author": "Aditya Bhat",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheBhat/todo_tasks.git"
  },
  "bugs": {
    "url": "https://github.com/TheBhat/todo_tasks/issues"
  },
  "homepage": "https://github.com/TheBhat/todo_tasks#readme",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "./extension.js",
  "icon": "resources/icon.png",
  "categories": [
    "Productivity",
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:todo-plus-plus.editor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "todo-plus-plus.editor",
        "displayName": "Todo++",
        "selector": [
          {
            "filenamePattern": "**/todo*.md"
          },
          {
            "filenamePattern": "**/ToDo*.md"
          },
          {
            "filenamePattern": "**/Todo*.md"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0"
  }
}
